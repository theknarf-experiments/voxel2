#!/bin/sh
# Commit gate: the workspace must be formatted, type-check, and be
# clippy-clean (warnings are errors). Install with `mise run setup`.
set -e

echo "pre-commit: cargo fmt --all --check"
cargo fmt --all --check

echo "pre-commit: cargo check --workspace --all-targets"
cargo check --workspace --all-targets

echo "pre-commit: cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

echo "pre-commit: OK"
